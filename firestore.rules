rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to validate ID strings
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.size() > 0;
    }

    // Proposals collection
    match /proposals/{proposalId} {
      allow read, write: if isValidId(proposalId);
    }

    // Settings collection (e.g. companyProfile)
    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
